{
  "manifest_version": 3,
  "name": "MySQL Web Studio",
  "version": "1.0.0",
  "description": "纯前端 MySQL 客户端：连接管理、库表浏览、SQL 执行、结果集编辑、脚本与导出",
  "minimum_chrome_version": "110",
  "author": "guonl",
  "homepage_url": "https://github.com/guonl/guonl-mysql-web-studio",
  "action": {
    "default_title": "打开 MySQL Web Studio"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "permissions": ["storage"]
}
