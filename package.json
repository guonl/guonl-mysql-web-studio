{
  "name": "mysql-web-studio",
  "private": true,
  "version": "1.0.0",
  "description": "纯前端 MySQL 客户端（MySQL Web Studio）",
  "author": "guonl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guonl/guonl-mysql-web-studio.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "start:desktop": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:signed": "npm run build && electron-builder --mac --config electron-builder.signed.yml --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "bridge": "node scripts/bridge-server.mjs",
    "build:ext": "npm run build && node scripts/build-ext.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-sql": "^6.2.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
